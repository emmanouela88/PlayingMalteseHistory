  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Gazette stopped mentioning victims by name after June. I have sufficient
    names and dates, however, to trace back to the first case. Unfortunately, there
    are all jumbled together so I should put them in order first. There are five
    people. I should find their name and surname (if it exists), their address, and
    the date they showed symptoms. Each entry should include only one, unique value.\r\r\n\r\n>
    The last named case was the 31st of May.\r\n> The black girl did not live in
    Strada Mercanti.\r\n> Schembri is the last name of the second case.\r\n> Salvatore
    got symptoms before the person whose last name is Re.\r\n> Ubaldisca is the name
    of the person who lived in Strada Santa Orsola.\r\n> Cremona got symptoms after
    Aloisia.\r\n> Borg lived in Strada San Paolo.\r\n> The person who lived in Strada
    Spedale got symptoms second before last.\r\n> Salvatore did not live in Strada
    San Giovanni.\r\n> The second case was recorded on the 16th of May and it was
    not Anna.\r\n> Anna, whose last name was not Re, lived in Strada Mercanti.\r\n>
    The first case was recorded 28 days before the last but not in Strada Giovanni.\r\n>
    Borg was not the third person who got symptoms on the 17th of May and before
    Aloisia.\r\n> The black girl got symptoms ten days before the second to last
    case.\r\n> The person who lived in Strada San Giovanni got symptoms before Re.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
