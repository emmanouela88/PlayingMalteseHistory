  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Gazette stopped mentioning victims by name after June. I have sufficient
    names and dates, however, to trace back to the first case. Unfortunately, there
    are all jumbled together so I should put them in order first. There are five
    people. I should find their name and surname (if it exists), their address, and
    the date they showed symptoms. Each entry should include only one, unique value,
    so in the end I should have a list of five people, their name, their surname,
    their address, and the date they got sick in the right order.\n\nThe last named
    case was on the 31st of May.\r\nThe black girl did not live in Strada Mercanti.\r\nSchembri
    is the last name of the second case.\r\nSalvatore got symptoms before the person
    whose last name is Re.\r\nUbaldisca is the name of the person who lived in Strada
    Santa Orsola.\r\nCremona got symptoms after Aloisia.\r\nBorg lived in Strada
    San Paolo.\r\nThe person who lived in Strada Spedale got symptoms second before
    last.\r\nSalvatore did not live in Strada San Giovanni.\r\nThe second case was
    recorded on the 16th of May and it was not Anna.\r\nAnna, whose last name was
    not Re, lived in Strada Mercanti.\r\nThe first case was recorded 28 days before
    the last but not in Strada Giovanni.\r\nBorg was not the third person who got
    symptoms on the 17th of May and before Aloisia.\r\nThe black girl got symptoms
    ten days before the second to last case.\r\nThe person who lived in Strada San
    Giovanni got symptoms before Re.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 893c3c9b3bd6d2f47852e446fb992d92, type: 2}
  m_sharedMaterial: {fileID: 5611675687574581459, guid: 893c3c9b3bd6d2f47852e446fb992d92, type: 2}
