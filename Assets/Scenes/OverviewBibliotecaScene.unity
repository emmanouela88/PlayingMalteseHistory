  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "JEWISH STORY: The story follows the Tayar family as they struggle to fit
    their personal and public lives in the predominantly Christian country of Malta.
    The player retraces the markings they left in Maltese history, starting from
    the focal point, Ondina Tayar, to her mother Rachele, her brother Oscar, and
    then ending with the initial struggle of Jewish immigrants landing in Malta.
    All of the Tayar stories offer an individual look into Jewish struggles in Malta
    while also relating them to those of the general Jewish residents of Malta.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3dab4aaee5eb57b49bb411e395a45278, type: 2}
  m_sharedMaterial: {fileID: -5798611287592534813, guid: 3dab4aaee5eb57b49bb411e395a45278, type: 2}
