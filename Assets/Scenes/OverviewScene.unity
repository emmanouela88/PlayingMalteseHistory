  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Mdina is beautiful at any time of year. Cobbled streets, medieval fortifications,
    and shadowy corners embody the so called Silent City. Malta\u2019s capital from
    antiquity until the 16th century and the arrival of the Order of St. John, or
    Knights Hospitaller, Mdina now hosts no more than 300 residents and a plethora
    of museums, glass shops, caf\xE9s, and pink bougainvillea vines. Gazing lazily
    at the colourful crowd of leisure tourists, I know that I will not find what
    I am looking for here. I need to go to where Malta\u2019s history peacefully
    slumbers and awaken it."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3dab4aaee5eb57b49bb411e395a45278, type: 2}
  m_sharedMaterial: {fileID: -5798611287592534813, guid: 3dab4aaee5eb57b49bb411e395a45278, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
  m_fontColor32:
