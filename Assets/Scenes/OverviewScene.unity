--- !u!114 &1063823782
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1063823780}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Inquisitor himself made the case against Sophia by bribing and influencing
    god-fearing simple people. He had apparently discovered that high ranking officers
    of the Order were keeping mistresses that were cloistered as nuns in a convent
    in Valletta. Sophia was one of them, mistress of knight Fra Sanese de Lango,
    Grand Commander of the Order, second in command only to the Grand Master himself.
    By accusing the prot\xE9g\xE9 of such an influential member of the knights \u2013
    of maleficarum all the more, demonic witchcraft and not simply pagan superstitions
    \u2013 he managed a very powerful display of power against the Order which was
    trying to compete with the Church for influence. An innocent woman burnt to the
    stake for the political games between two very powerful men. I should visit the
    convent in Valletta even though I am not sure where it is anymore. Maybe I can
    also search for further entries in the diary that would help me understand the
    mind behind this atrocious crime."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3dab4aaee5eb57b49bb411e395a45278, type: 2}
  m_sharedMaterial: {fileID: -5798611287592534813, guid: 3dab4aaee5eb57b49bb411e395a45278, type: 2}
