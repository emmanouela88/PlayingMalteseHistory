  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "When I arrive at the Palace I am taken aback by the beautiful architecture.
    How can a place of such beauty hold so dark a past? I need to go inside to discover
    more. I get as excited as a child before Christmas when I realise that in one
    of the palace\u2019s rooms, personal diaries of the Inquisitors\u2019 are exhibited.
    My excitement becomes exhilaration when I notice that one of the diaries is indeed
    from the period I am interested in. I try the glass cover. God must be on my
    side because it is not locked. I take a cautious look around. No guard and no
    other visitor, I cannot see any cameras watching over either. With a leap of
    faith I lift the glass cover and gently remove the diary. I open it with trembling
    hands, being extremely careful with the frail material. The records are conveniently
    dated by a meticulous writer. I read voraciously through the pages, uncovering
    a haunting story.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3dab4aaee5eb57b49bb411e395a45278, type: 2}
  m_sharedMaterial: {fileID: -5798611287592534813, guid: 3dab4aaee5eb57b49bb411e395a45278, type: 2}
