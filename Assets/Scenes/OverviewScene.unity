  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I manage to find the old convent. I stand outside looking upwards. The
    place is not open to the public anymore for many years now. The scene of Sophia\u2019s
    capture is playing out in my mind; my imagination fired up by the recounts I
    have been reading, filling in the personal details of an otherwise detached,
    administrative narrative. It must have been night when they came for her, midnight;
    the witching hour. She must have been fast asleep in her bed in a separate, luscious
    bedroom, a perk for being the mistress of Fra. The guards might have knocked
    on her door, banged more likely, to warn her, give her some decency to get dressed.
    Or they could have even barged inside, broken the wooden door down, and brutally
    woken her up. She must have been so lost, so alone, and afraid. They would have
    pronged her, grabbed her, pulled her violently away from her bed, her room, her
    convent, her life. Dressed still in her nightclothes, they must have dragged
    her outside and onto the prison carriage. Her imprisonment must have been short,
    her trial even more so. The Inquisitor could not risk the Grand Commander finding
    out and having time to find a way to save her. Accused for witchcraft, condemned
    by people whom she had never seen before, did not even know her, Sophia was charged
    with death; by fire at the stake."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3dab4aaee5eb57b49bb411e395a45278, type: 2}
  m_sharedMaterial: {fileID: -5798611287592534813, guid: 3dab4aaee5eb57b49bb411e395a45278, type: 2}
