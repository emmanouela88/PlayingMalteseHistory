  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Inquisitor examined himself and his own motives before God. He delivered
    himself from evil with a blessed flail and felt divinely justified. He was doing
    God's work. He was doing man's work too, Rome would benefit and political interests
    were at stake; were these more worldly than Godly? Several lashes exorcised his
    doubts. Conviction restored, he knew God (and Rome) were in accord. A benefit
    to Rome was glory to God. He was simply their agent. His resolve was hard and
    pure, by the strength of God\u2019s will. A heavy duty to bear, but \u2013 no
    one more suitable than him, none who prayed more fervently. Though he could look
    forward to just rewards, of course. The fire would burn her sins away, just as
    the fever rose and the barbs flayed his skin."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3dab4aaee5eb57b49bb411e395a45278, type: 2}
  m_sharedMaterial: {fileID: -5798611287592534813, guid: 3dab4aaee5eb57b49bb411e395a45278, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
